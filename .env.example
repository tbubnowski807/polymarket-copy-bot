# ============================================================================
# Polymarket Copy Bot — environment variables
# ALL keys are OPTIONAL for version one. The bot runs fully on public APIs
# and clearly-labeled demo data with no keys at all.
#
# SAFETY: There is NO variable for a private key, wallet secret, or mnemonic.
# This app never signs transactions and never spends money. Do not add one.
# ============================================================================

# Local SQLite database (Prisma). Default works out of the box.
DATABASE_URL="file:./dev.db"

# --- Data source toggles -----------------------------------------------------
# "live"  -> attempt real Polymarket public APIs; on failure, STOP and show the
#            real error (never silently fake data).
# "demo"  -> use clearly-labeled seed/demo data only (no network).
# "auto"  -> try live, and if the network is unavailable fall back to demo,
#            but every demo record is explicitly labeled as demo in the UI.
DATA_MODE="auto"

# Leaderboard source: "polymarket" or "bullpen"
LEADERBOARD_SOURCE="polymarket"

# --- Optional public API base URLs (override only if they change) ------------
POLYMARKET_DATA_API="https://data-api.polymarket.com"
POLYMARKET_GAMMA_API="https://gamma-api.polymarket.com"
POLYMARKET_CLOB_API="https://clob.polymarket.com"

# Min milliseconds between gamma market lookups (Cloudflare rate-limit guard).
GAMMA_MIN_INTERVAL_MS="120"

# --- Optional Telegram alerts (leave blank to disable) -----------------------
# If unset, reports are written to the DB and printed to stdout only.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Paper-trading parameters (safe defaults) --------------------------------
PAPER_MIN_SIZE_USD="5"
PAPER_MAX_SIZE_USD="20"
